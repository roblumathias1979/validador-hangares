; Copie para coletor.ini (na mesma pasta) e preencha o token.
; O coletor.ini NÃO vai para o git: tem o token.

[techparking]
url = http://172.16.10.252:7002

[destino]
url = https://validador.1park.com.br/api/techparking/snapshot
; O mesmo valor de TECHPARKING_COLETOR_TOKEN no .env do servidor.
token =
; Arquivo de raizes para validar o HTTPS. Padrao: ca-validador.pem, que vem
; junto do coletor — a maquina do aeroporto tem raizes vencidas e recusa a
; conexao sem ele. Deixe em branco para usar as raizes da propria maquina.
ca_bundle = ca-validador.pem

[coletor]
; Segundos entre um envio de SNAPSHOT e outro (varre o TECHPARKING).
intervalo = 60

; Segundos entre uma puxada de VALIDAÇÕES e outra. Bem menor que o snapshot:
; na contingência (ValidPark fora) o cliente espera a resposta na hora, então a
; fila é puxada a cada poucos segundos. Puxar é leve (um GET ao servidor).
; Padrão 3. Só é usada na execução contínua.
intervalo_validacoes = 3

; Validação de ticket vencido (opcional — só é usada no teste --validar e,
; depois, na execução das autorizações vindas do WhatsApp). Os padrões já são
; os valores certos; preencha só se algo mudar.
[validador]
; Pátio onde o ticket vencido é validado. 31 = #1PARK.
patio_id = 31
patio_label = #1PARK
; Nova tolerância, em dias.
dias = 20
; Nome que fica registrado como quem validou.
usuario_logged = BOT_1PARK
; Token Bearer da API, SE ela exigir para o PUT. Vazio = tenta sem.
token =
