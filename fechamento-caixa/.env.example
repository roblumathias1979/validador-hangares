# Copie para .env (gitignored) e preencha.

# Mesma Evolution API já usada pelo validador de hangares neste servidor —
# reaproveitar o número/instância existente evita custo de um segundo chip.
# Se preferir uma instância própria, troque EVOLUTION_INSTANCE.
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=validador-hangares
EVOLUTION_API_KEY=

# Usada para o OCR do relatório de fechamento (Anthropic/Claude com visão).
ANTHROPIC_API_KEY=

# Painel web (fechamento-caixa/painel/servidor.js).
PAINEL_CAIXA_PORTA=8082
PAINEL_CAIXA_SENHA=
