# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o arquivo .env (já está no .gitignore).

# --- n8n ---
N8N_ENCRYPTION_KEY=gere-uma-chave-aleatoria-forte-aqui
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=America/Sao_Paulo

# Necessário para habilitar o nó "Execute Command", que vem desabilitado
# por padrão no n8n e é exatamente o nó que este workflow usa para chamar
# os scripts. Sem isso: "Unrecognized node type: n8n-nodes-base.executeCommand".
# No servidor AWS isso está definido no /etc/systemd/system/n8n.service.
NODES_EXCLUDE=[]

# --- WhatsApp (Evolution API) ---
WHATSAPP_SESSION_NAME=validador-hangares
# A Evolution roda em Docker na mesma máquina, publicada SOMENTE em 127.0.0.1
# (nada exposto à internet). A chave é gerada no servidor, em
# /home/ubuntu/evolution/.env — copiar de lá, nunca inventar outra.
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=validador-hangares
EVOLUTION_API_KEY=

# --- OCR ---
# Escolher um provedor e preencher a respectiva chave
GOOGLE_CLOUD_VISION_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Asaas (emissão de boleto quando a cota de validações fora do prazo
# acaba — ver scripts/lib/asaas.js e docs/perguntas-abertas.md) ---
# ASAAS_AMBIENTE: "sandbox" (testes, sem cobrança real) ou "producao".
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=

# --- Painel de controle ---
# Senha do painel (usuario pode ser qualquer coisa). Gerar no servidor com
# `openssl rand -hex 24` — o painel nao sobe sem ela.
PAINEL_SENHA=
PAINEL_PORTA=8081

# --- Credenciais por hangar ---
# Uma variável de usuário e uma de senha por hangar, referenciadas em config/hangares.json
# ATENÇÃO: se a senha começar com "#", ela PRECISA estar entre aspas
# (ex: SENHA="#1ALGO"), senão o dotenv trata o "#" como início de comentário
# e a senha vira string vazia silenciosamente — confirmado testando de
# verdade em 11/09/2026 (várias senhas dos hangares vêm no formato #1XXXX).
SOLOJET_USUARIO=
SOLOJET_SENHA=

# Hangar AIBM — referenciado em config/hangares.json, mas ainda não
# confirmado se usa o mesmo validador (ValidPark) do Solojet. Exige foto do
# veículo no local (ver exigeFotoVeiculoNoLocal em config/hangares.json).
AIBM_USUARIO=
AIBM_SENHA=

# AIBM 2 — pátio distinto do AIBM acima, mesma exigência de foto do veículo.
AIBM_2_USUARIO=
AIBM_2_SENHA=

# Demais hangares cadastrados em 11/09/2026 (skeleton em config/hangares.json:
# ainda faltam URL do validador, seletores e grupo do WhatsApp de cada um).
SOLOJET_SHARES_USUARIO=
SOLOJET_SHARES_SENHA=
PLANE_AVIATION_USUARIO=
PLANE_AVIATION_SENHA=
NACOES_USUARIO=
NACOES_SENHA=
INDAIA_USUARIO=
INDAIA_SENHA=
HANGAR_1_USUARIO=
HANGAR_1_SENHA=
HANGAR_ARISTEK_USUARIO=
HANGAR_ARISTEK_SENHA=
EPEAC_USUARIO=
EPEAC_SENHA=
DUX_EXPRESS_USUARIO=
DUX_EXPRESS_SENHA=
CONCORDE_USUARIO=
CONCORDE_SENHA=
CIMED_ALLJET_USUARIO=
CIMED_ALLJET_SENHA=
BRAVO_AVIATION_USUARIO=
BRAVO_AVIATION_SENHA=
ALLJET_USUARIO=
ALLJET_SENHA=
AERIE_AVIACAO_EXECUTIVA_USUARIO=
AERIE_AVIACAO_EXECUTIVA_SENHA=

# Adicionar novas linhas aqui conforme novos hangares forem cadastrados
