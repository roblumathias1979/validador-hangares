[Unit]
Description=Avisa a administracao se ha atualizacao pendente no servidor
After=network-online.target docker.service n8n.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/validador-hangares
ExecStart=/usr/bin/node /home/ubuntu/validador-hangares/scripts/avisar-atualizacoes.js
